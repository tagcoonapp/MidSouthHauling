// Midsouth Hauling: one Cloudflare Worker serves the API (/api/*) and the built web app (dist/).
// Free plan: Workers, D1 (database) and R2 (photo storage) all stay inside the free tier at this size.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midsouthhauling",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // database_id is filled in when the production database is created (see README "Deploy").
  "d1_databases": [
    { "binding": "DB", "database_name": "midsouthhauling-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "midsouthhauling-files" }],
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "TIMEZONE": "America/Chicago"
  }
}
