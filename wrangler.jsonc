// Midsouth Hauling: one Cloudflare Worker serves the API (/api/*) and the web app (embedded at build time).
// Free plan: Workers, D1 (database) and R2 (photo storage) all stay inside the free tier at this size.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midsouthhauling",
  "account_id": "df1f7ac8bc16389cd6206e6088c4d86d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Production database (free plan).
  "d1_databases": [
    { "binding": "DB", "database_name": "midsouthhauling-db", "database_id": "b82e5361-58fd-4712-b2f7-2b04c1698dd5", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "midsouthhauling-files" }],
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }],
  // 06:10 UTC = 12:10 AM Central (1:10 AM in summer): move unsubmitted jobs from past days back to the pipeline.
  "triggers": { "crons": ["10 6 * * *"] },
  "vars": {
    "TIMEZONE": "America/Chicago"
  }
}
